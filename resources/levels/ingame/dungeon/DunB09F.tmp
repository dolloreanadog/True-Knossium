[node name="Label" type="Label" parent="Notes"]
layout_mode = 0
offset_top = -112.0
offset_right = 1152.0
text = "We're doing small resolution for testing, when finalizing switch to higher resolution.
Once finished we will put everything working into dungeon_finalized, will also remove the testing bloat of this current scene.
We Should a special kind of area denial outside the viewable area just in case the player is dumb enough to put it there.
Put an invisible colorRect on z_index = 2, to block player ability to touch stuff"

