; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Knossium"
run/main_scene="res://resources/levels/MainMenu.tscn"
config/features=PackedStringArray("4.1", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://AudioBus.tres"

[autoload]

Global="*res://resources/scripts/Global.gd"
SaveSystem="*res://resources/scripts/SaveScript.gd"
SettingsSystem="*res://resources/scripts/SettingsScript.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://Documents/Godot/knossium-crash.log"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/initial_position_type=0
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

export/convert_text_resources_to_binary=false

[input]

